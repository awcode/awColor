{
    "name": "awcode/awcolor",
    "description": "Modern PHP color management library with conversions, manipulation, schemes and WCAG accessibility helpers across hex, rgb(a), hsl(a), hsv, cmyk and CSS named colors.",
    "type": "library",
    "keywords": [
        "color",
        "colour",
        "rgb",
        "rgba",
        "hex",
        "hsl",
        "hsla",
        "hsv",
        "cmyk",
        "wcag",
        "contrast",
        "accessibility",
        "palette"
    ],
    "homepage": "https://github.com/awcode/awColor",
    "license": "MIT",
    "authors": [
        {
            "name": "Mark Walker",
            "homepage": "https://awcode.com",
            "role": "creator"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "AWcode\\": "src/AWcode/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AWcode\\Tests\\": "Tests/AWcode/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
